# RSVP storage (Supabase). Without these, replies are written to data/rsvps.jsonl (local testing only).
# Table: create table rsvps (id bigint generated always as identity primary key, name text not null,
#        attending boolean not null, guests int default 0, message text, created_at timestamptz default now());
